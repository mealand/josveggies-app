APP_NAME=JosVeggies
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_TIMEZONE=Africa/Lagos
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=josveggies
DB_USERNAME=josveggies
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@josveggies.ng"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- JosVeggies -------------------------------------------------------------
SESSION_SECURE_COOKIE=false
STAFF_SESSION_IDLE_MINUTES=30

# Payment gateway: "fake" (local only, simulated checkout) or "paystack"
PAYMENT_GATEWAY=fake
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# SMS driver: "log" (writes to storage/logs/sms.log) or "termii"
SMS_DRIVER=log
TERMII_API_KEY=
TERMII_SENDER_ID=JosVeggies
TERMII_CHANNEL=dnd
TERMII_BASE_URL=https://v3.api.termii.com

SUPPORT_WHATSAPP_NUMBER=2348000000000
SUPPORT_EMAIL=hello@josveggies.ng

# Off-site backups (S3-compatible, e.g. Cloudflare R2 / Backblaze B2)
BACKUP_DISK=local
BACKUP_NOTIFY_EMAIL=
